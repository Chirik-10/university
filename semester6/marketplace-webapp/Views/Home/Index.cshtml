@model IEnumerable<InternetShop.Models.Product>

@{
    ViewData["Title"] = "Каталог товаров";
    var categories = ViewBag.Categories as List<InternetShop.Models.Category>;
    var selectedCategory = ViewBag.SelectedCategoryId ?? 0;
    var minPrice = ViewBag.MinPrice;
    var maxPrice = ViewBag.MaxPrice;
}

<h2 style="color: #d46b8c;">Каталог товаров</h2>

<div style="margin: 20px 0; padding: 25px; background: #fce4ec; border-radius: 30px;">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px;">
        <!-- Поиск -->
        <div style="flex: 2; min-width: 220px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #d46b8c;">Поиск:</label>
            <input type="text" id="searchString" name="searchString" value="@ViewBag.SearchString"
                   placeholder="Введите название товара..."
                   style="width: 100%; padding: 12px; border: 1px solid #f0d3d8; border-radius: 40px;" />
        </div>

        <!-- Категория -->
        <div style="flex: 1; min-width: 180px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #d46b8c;">Категория:</label>
            <select id="categoryId" name="categoryId" style="width: 100%; padding: 12px; border: 1px solid #f0d3d8; border-radius: 40px;">
                <option value="0">Все категории</option>
                @if (categories != null)
                {
                    foreach (var cat in categories)
                    {
                        if (selectedCategory == cat.Id)
                        {
                            <option value="@cat.Id" selected>@cat.Name</option>
                        }
                        else
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                }
            </select>
        </div>

        <!-- Цена от -->
        <div style="flex: 1; min-width: 150px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #d46b8c;">Цена от (₽):</label>
            <input type="number" step="0.01" min="0" id="minPrice" name="minPrice" value="@minPrice"
                   style="width: 100%; padding: 12px; border: 1px solid #f0d3d8; border-radius: 40px;" />
        </div>

        <!-- Цена до -->
        <div style="flex: 1; min-width: 150px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #d46b8c;">Цена до (₽):</label>
            <input type="number" step="0.01" min="0" id="maxPrice" name="maxPrice" value="@maxPrice"
                   style="width: 100%; padding: 12px; border: 1px solid #f0d3d8; border-radius: 40px;" />
        </div>

        <!-- Кнопки -->
        <div style="display: flex; gap: 15px; min-width: 200px;">
            <button id="applyFiltersBtn" style="padding: 12px 28px; background: #d47a92; color: white; border: none; border-radius: 40px; cursor: pointer; font-weight: 500;">
                Применить
            </button>
            <a href="/Home/Index" id="resetFiltersBtn" style="display: inline-block; padding: 12px 28px; background: #d47a92; color: white; text-decoration: none; border-radius: 40px; font-weight: 500; text-align: center;">
                Сбросить
            </a>
        </div>
    </div>

    <div id="searchMessage" style="margin-top: 20px; color: #d46b8c; text-align: center;"></div>
</div>

<div id="productsContainer">
    @await Html.PartialAsync("_ProductsGrid", Model)
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    $(document).ready(function() {
        function loadProducts() {
            var searchString = $('#searchString').val();
            var categoryId = $('#categoryId').val();
            var minPrice = $('#minPrice').val();
            var maxPrice = $('#maxPrice').val();

            $.ajax({
                url: '/Home/FilterProducts',
                type: 'GET',
                data: {
                    searchString: searchString,
                    categoryId: categoryId,
                    minPrice: minPrice,
                    maxPrice: maxPrice
                },
                success: function(data) {
                    $('#productsContainer').html(data);
                }
            });
        }

        $('#applyFiltersBtn').on('click', function(e) {
            e.preventDefault();
            loadProducts();
        });

        $('#resetFiltersBtn').on('click', function(e) {
            e.preventDefault();
            window.location.href = '/Home/Index';
        });

        $('#categoryId').on('change', function() {
            loadProducts();
        });

        var searchTimeout;
        $('#searchString').on('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(function() {
                loadProducts();
            }, 500);
        });
    });
</script>