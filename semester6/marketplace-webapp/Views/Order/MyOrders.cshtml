@model IEnumerable<InternetShop.Models.Order>

@{
    ViewData["Title"] = "Мои заказы";
}

<h2>Мои заказы</h2>

@if (TempData["Success"] != null)
{
    <div style="background: #d4edda; color: #155724; padding: 10px; border-radius: 4px; margin-bottom: 20px;">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="background: #f8d7da; color: #721c24; padding: 10px; border-radius: 4px; margin-bottom: 20px;">
        @TempData["Error"]
    </div>
}

@if (!Model.Any())
{
    <p>У вас пока нет заказов</p>
    <a href="/" style="display: inline-block; padding: 10px 20px; background: #4CAF50; color: white; text-decoration: none; border-radius: 3px;">Перейти в каталог</a>
}
else
{
    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="background: #333; color: white;">
                <th style="padding: 10px; text-align: center;">№ заказа</th>
                <th style="padding: 10px; text-align: center;">Дата</th>
                <th style="padding: 10px; text-align: center;">Сумма</th>
                <th style="padding: 10px; text-align: center;">Статус</th>
                <th style="padding: 10px; text-align: center;">Адрес</th>
                <th style="padding: 10px; text-align: center;">Состав заказа</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd; text-align: center;">@order.Id</td>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd; text-align: center;">@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd; text-align: center;">@order.TotalAmount.ToString("C")</td>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd; text-align: center;">
                        @if (order.Status == "New")
                        {
                            <span style="color: blue; font-weight: bold;">Новый</span>
                        }
                        else if (order.Status == "Confirmed")
                        {
                            <span style="color: green; font-weight: bold;">Подтверждён</span>
                        }
                        else if (order.Status == "Cancelled")
                        {
                            <span style="color: red; font-weight: bold;">Отклонён</span>
                            if (!string.IsNullOrEmpty(order.RejectReason))
                            {
                                <div><small style="color: red;">Причина: @order.RejectReason</small></div>
                            }
                        }
                    </td>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd; text-align: center;">@order.Address</td>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd; text-align: left;">
                        @foreach (var item in order.OrderItems)
                        {
                            <div>@item.Product?.Name x @item.Quantity шт. = @((item.Quantity * item.PriceAtOrder).ToString("C"))</div>
                        }
                        @if (order.Status == "New")
                        {
                            <form method="post" action="/Order/CancelOrder" style="margin-top: 10px;" onsubmit="return confirm('Отменить заказ №@order.Id?');">
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <button type="submit" style="padding: 5px 10px; background: #f44336; color: white; border: none; border-radius: 3px; cursor: pointer;">Отменить заказ</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}