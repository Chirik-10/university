@model IEnumerable<InternetShop.Models.Product>

@{
    ViewData["Title"] = "Управление товарами";
}

<h2 style="color: #d46b8c;">Управление товарами</h2>

@if (TempData["Success"] != null)
{
    <div style="background: #fce4ec; color: #d46b8c; padding: 15px; border-radius: 15px; margin-bottom: 20px; border: 1px solid #f8d0dc;">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="background: #f8d7da; color: #721c24; padding: 15px; border-radius: 15px; margin-bottom: 20px; border: 1px solid #f5c6cb;">
        @TempData["Error"]
    </div>
}

<p>
    <a href="/Admin/CreateProduct" style="display: inline-block; padding: 10px 24px; background: #e8a9b5; color: white; text-decoration: none; border-radius: 40px; margin-bottom: 20px; font-weight: 500;">
        + Добавить товар
    </a>
</p>

<table style="width: 100%; border-collapse: collapse;">
    <thead>
        <tr style="background: #f7c5ce; color: white;">
            <th style="padding: 10px; text-align: center;">ID</th>
            <th style="padding: 10px; text-align: center;">Название</th>
            <th style="padding: 10px; text-align: center;">Цена</th>
            <th style="padding: 10px; text-align: center;">Категория</th>
            <th style="padding: 10px; text-align: center;">Наличие</th>
            <th style="padding: 10px; text-align: center;">Действия</th>
        <tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td style="padding: 10px; border-bottom: 1px solid #f0d3d8; text-align: center;">@product.Id</td>
                <td style="padding: 10px; border-bottom: 1px solid #f0d3d8; text-align: center;">@product.Name</td>
                <td style="padding: 10px; border-bottom: 1px solid #f0d3d8; text-align: center;">@product.Price.ToString("C")</td>
                <td style="padding: 10px; border-bottom: 1px solid #f0d3d8; text-align: center;">@product.Category?.Name</td>
                <td style="padding: 10px; border-bottom: 1px solid #f0d3d8; text-align: center;">@product.Stock</td>
                <td style="padding: 10px; border-bottom: 1px solid #f0d3d8; text-align: center;">
                    <a href="/Admin/EditProduct/@product.Id" style="padding: 6px 16px; background: #ffb347; color: white; text-decoration: none; border-radius: 40px; display: inline-block; margin-right: 5px;">Редактировать</a>
                    <form method="post" action="/Admin/DeleteProduct" style="display: inline;" onsubmit="return confirm('Удалить товар?');">
                        <input type="hidden" name="id" value="@product.Id" />
                        <button type="submit" style="padding: 6px 16px; background: #dd8f9e; color: white; border: none; border-radius: 40px; cursor: pointer;">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>