@model List<InternetShop.Models.CartItem>

@{
    ViewData["Title"] = "Корзина";
}

<h2 style="color: #d46b8c;">Корзина</h2>

@if (Model == null || !Model.Any())
{
    <p>Ваша корзина пуста</p>
    <a href="/" style="display: inline-block; padding: 12px 28px; background: #d47a92; color: white; text-decoration: none; border-radius: 40px; font-weight: 500;">
        Продолжить покупки
    </a>
}
else
{
    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="background: #e89aaf; color: white;">
                <th style="padding: 10px; text-align: center;">Товар</th>
                <th style="padding: 10px; text-align: center;">Цена</th>
                <th style="padding: 10px; text-align: center;">Количество</th>
                <th style="padding: 10px; text-align: center;">Сумма</th>
                <th style="padding: 10px; text-align: center;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="row-@item.ProductId">
                    <td style="padding: 10px; border-bottom: 1px solid #f0d3d8; text-align: center;">@item.ProductName</td>
                    <td style="padding: 10px; border-bottom: 1px solid #f0d3d8; text-align: center;">@item.Price.ToString("C")</td>
                    <td style="padding: 10px; border-bottom: 1px solid #f0d3d8; text-align: center;">
                        <div style="display: flex; justify-content: center; align-items: center; gap: 10px;">
                            <button class="btn-decrease" data-id="@item.ProductId" style="width: 34px; height: 34px; background: #d47a92; color: white; border: none; border-radius: 50%; cursor: pointer; font-size: 18px; font-weight: bold; display: flex; align-items: center; justify-content: center; text-align: center;">-</button>
                            <span id="qty-@item.ProductId" style="min-width: 40px; text-align: center; font-size: 16px;">@item.Quantity</span>
                            <button class="btn-increase" data-id="@item.ProductId" style="width: 34px; height: 34px; background: #d47a92; color: white; border: none; border-radius: 50%; cursor: pointer; font-size: 18px; font-weight: bold; display: flex; align-items: center; justify-content: center; text-align: center;">+</button>
                        </div>
                    </td>
                    <td style="padding: 10px; border-bottom: 1px solid #f0d3d8; text-align: center;" id="total-@item.ProductId">@item.Total.ToString("C")</td>
                    <td style="padding: 10px; border-bottom: 1px solid #f0d3d8; text-align: center;">
                        <button class="btn-remove" data-id="@item.ProductId" style="padding: 6px 16px; background: #b85c74; color: white; border: none; border-radius: 40px; cursor: pointer;">Удалить</button>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" style="text-align: right; padding: 10px;"><strong>Итого:</strong></td>
                <td colspan="2" style="padding: 10px;"><strong id="cartTotal">@Model.Sum(i => i.Total).ToString("C")</strong></td>
            </tr>
        </tfoot>
    </table>

    <div style="margin-top: 25px; display: flex; gap: 15px; flex-wrap: wrap; justify-content: center;">
        <a href="/Order/Checkout" style="display: inline-block; padding: 12px 28px; background: #d47a92; color: white; text-decoration: none; border-radius: 40px; font-weight: 500;">
            Оформить заказ
        </a>
        <a href="/" style="display: inline-block; padding: 12px 28px; background: #d47a92; color: white; text-decoration: none; border-radius: 40px; font-weight: 500;">
            Продолжить покупки
        </a>
    </div>
}

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    $(document).ready(function() {
        $('.btn-increase').on('click', function() {
            var productId = $(this).data('id');
            $.ajax({
                url: '/Cart/IncreaseQuantity',
                type: 'POST',
                data: { productId: productId, maxStock: 999 },
                success: function(response) {
                    if (response.success) location.reload();
                    else alert(response.message);
                }
            });
        });

        $('.btn-decrease').on('click', function() {
            var productId = $(this).data('id');
            var currentQty = parseInt($('#qty-' + productId).text());

            if (currentQty > 1) {
                $.ajax({
                    url: '/Cart/DecreaseQuantity',
                    type: 'POST',
                    data: { productId: productId },
                    success: function(response) {
                        if (response.success) location.reload();
                    }
                });
            } else {
                if (confirm('Удалить товар из корзины?')) {
                    $.ajax({
                        url: '/Cart/RemoveFromCart',
                        type: 'POST',
                        data: { productId: productId },
                        success: function(response) {
                            if (response.success) location.reload();
                        }
                    });
                }
            }
        });

        $('.btn-remove').on('click', function() {
            if (!confirm('Удалить товар из корзины?')) return;
            var productId = $(this).data('id');
            $.ajax({
                url: '/Cart/RemoveFromCart',
                type: 'POST',
                data: { productId: productId },
                success: function(response) {
                    if (response.success) location.reload();
                    else alert(response.message);
                }
            });
        });
    });
</script>